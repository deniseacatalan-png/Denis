		<kml:Point>
			<kml:coordinates>-71.30014676797302,-40.13506679782964,725.4636189851171</kml:coordinates>
		</kml:Point>
	</kml:Placemark>
<kml:Placemark id="05676F7F583612FE86BD">
		<kml:name>HUILQUIL CASONA DE MONTAÑA</kml:name>
		<kml:description>&lt;div&gt;CASA TURISTICA PARA 10712 PAX&lt;br&gt;&lt;/div&gt;&lt;div&gt;Valor temporada 2025&lt;br&gt;&lt;/div&gt;&lt;div&gt;U$d 570 baja&amp;nbsp;&lt;br&gt;&lt;/div&gt;&lt;div&gt;600 media&lt;br&gt;&lt;/div&gt;&lt;div&gt;650 alta&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Abre el 4 de ABRIL//&lt;br&gt;&lt;/div&gt;</kml:description>
		<kml:LookAt>
			<kml:longitude>-71.28268010174658</kml:longitude>
			<kml:latitude>-40.1201497067261</kml:latitude>
